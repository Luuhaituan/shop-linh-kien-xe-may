@startuml AD06_Huy_Don_Hang

skinparam backgroundColor #FFF5F5
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ActivityBorderColor #B71C1C
skinparam ActivityBackgroundColor #FFCDD2
skinparam ActivityDiamondBackgroundColor #FFF9C4
skinparam ActivityDiamondBorderColor #F9A825
skinparam ActivityStartColor #B71C1C
skinparam ActivityEndColor #1B5E20
skinparam ArrowColor #B71C1C
skinparam NoteBackgroundColor #FFF9C4
skinparam NoteBorderColor #F9A825

title
    <b><size:16>AD-06: Huy Don Hang</size></b>
    <size:11>He Thong Ban Linh Kien Xe May</size>
    <size:10>Trang: DonHang.aspx | API: HuyDonHangApi.ashx?action=huy</size>
end title

|#FFF5F5| User (DonHang.aspx) |
|#E3F2FD| HuyDonHangApi.ashx |
|#E8F5E9| Database (SQL Server) |

|User (DonHang.aspx)|
start
:Xem danh sach don hang;
:Chon don hang can huy;
:Nhan nut "Huy Don Hang";
:Hien thi hop xac nhan:\n"Ban co chac muon huy?";
if (Dong y huy?) then (Khong)
  :Dong hop thoai;
  stop
else (Co)
endif
:Gui POST:\nHuyDonHangApi.ashx?action=huy\n&id={maDonHang};

|HuyDonHangApi.ashx|
:Nhan request;
if (Session["User"] ton tai?) then (Khong)
  #FFB3B3 :Tra ve loi:\n{ success: false,\n  message: "Chua dang nhap" };
  stop
else (Co)
endif

:Lay MaNguoiDung tu Session;

|Database (SQL Server)|
:SELECT * FROM DonHang\nWHERE MaDonHang = @maDH;

|HuyDonHangApi.ashx|
if (Don hang ton tai?) then (Khong)
  #FFB3B3 :Tra ve loi:\n"Don hang khong ton tai";
  stop
else (Co)
endif

if (DonHang.MaNguoiDung\n= Session User?) then (Khong)
  #FFB3B3 :Tra ve loi:\n"Khong co quyen huy\ndon hang nay";
  stop
else (Co)
endif

if (TrangThaiDon =\n"Cho xac nhan"?) then (Khong)
  #FFB3B3 :Tra ve loi:\n{ success: false,\n  message: "Khong the huy\n  don hang o trang thai nay" };
  note right
    Chi duoc huy khi:
    TrangThaiDon = "Cho xac nhan"
    Cac trang thai khac deu bi tu choi
  end note
  |User (DonHang.aspx)|
  :Hien thi thong bao:\n"Khong the huy don hang nay!";
  stop
else (Co - "Cho xac nhan")
endif

|Database (SQL Server)|
#D5E8D4 :UPDATE DonHang\nSET TrangThaiDon = 'Da huy'\nWHERE MaDonHang = @maDH;

|HuyDonHangApi.ashx|
:Tra ve:\n{ success: true };

|User (DonHang.aspx)|
#D5E8D4 :Cap nhat giao dien:;
:Trang thai don hien thi\n"Da huy" (mau do);
:Nhat "Huy Don" bi an;
stop

@enduml
