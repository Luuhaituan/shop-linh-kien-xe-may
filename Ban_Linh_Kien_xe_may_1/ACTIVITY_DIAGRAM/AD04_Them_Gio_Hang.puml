@startuml AD04_Them_Gio_Hang

skinparam backgroundColor #FFFDE7
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ActivityBorderColor #E65100
skinparam ActivityBackgroundColor #FFE0B2
skinparam ActivityDiamondBackgroundColor #FFF9C4
skinparam ActivityDiamondBorderColor #F9A825
skinparam ActivityStartColor #E65100
skinparam ActivityEndColor #1B5E20
skinparam ArrowColor #E65100
skinparam NoteBackgroundColor #FFF9C4
skinparam NoteBorderColor #F9A825

title
    <b><size:16>AD-04: Them San Pham Vao Gio Hang</size></b>
    <size:11>He Thong Ban Linh Kien Xe May</size>
    <size:10>API: GioHangApi.ashx (action=add) | Bang: GioHang, ChiTietGioHang</size>
end title

|#FFFDE7| User (Trinh Duyet) |
|#E3F2FD| GioHangApi.ashx |
|#E8F5E9| Database (SQL Server) |

|User (Trinh Duyet)|
start
:Xem trang ChiTietSanPham.aspx\nhoac SanPham.aspx;
:Chon so luong muon mua;
:Nhan nut "Them Vao Gio Hang";
:Gui POST: { maLinhKien, soLuong };

|GioHangApi.ashx|
:Nhan request;
if (Session["User"] ton tai?) then (Khong)
  #FFB3B3 :Tra ve:\n{ success: false,\n  message: "not_logged_in" };
  |User (Trinh Duyet)|
  :Hien thi popup:\n"Vui long dang nhap";
  stop
else (Co)
endif

:Lay MaNguoiDung tu Session;

|Database (SQL Server)|
:SELECT MaGioHang FROM GioHang\nWHERE MaNguoiDung = @mand;

|GioHangApi.ashx|
if (GioHang ton tai?) then (Khong)
  |Database (SQL Server)|
  #FFF3E0 :INSERT INTO GioHang\n(MaNguoiDung, NgayCapNhat)\nVALUES (@mand, GETDATE());
  note right
    Tao gio hang moi
    tu dong cho User
  end note
  |GioHangApi.ashx|
  :Lay MaGioHang moi;
else (Co)
  :Lay MaGioHang hien co;
endif

|Database (SQL Server)|
:SELECT * FROM ChiTietGioHang\nWHERE MaGioHang = @magh\n  AND MaLinhKien = @malk;

|GioHangApi.ashx|
if (SP da co\ntrong gio hang?) then (Co)
  |Database (SQL Server)|
  #FFF3E0 :UPDATE ChiTietGioHang\nSET SoLuong = SoLuong + @sl\nWHERE MaGioHang = @magh\n  AND MaLinhKien = @malk;
  note right
    Cong don so luong
    neu SP da co trong gio
  end note
else (Chua)
  |Database (SQL Server)|
  #D5E8D4 :INSERT INTO ChiTietGioHang\n(MaGioHang, MaLinhKien, SoLuong)\nVALUES (@magh, @malk, @sl);
endif

:UPDATE GioHang\nSET NgayCapNhat = GETDATE()\nWHERE MaGioHang = @magh;

|GioHangApi.ashx|
:Tra ve:\n{ success: true };

|User (Trinh Duyet)|
#D5E8D4 :Hien thi thong bao:\n"Da them vao gio hang!";
:Cap nhat so luong icon gio hang;
stop

@enduml
