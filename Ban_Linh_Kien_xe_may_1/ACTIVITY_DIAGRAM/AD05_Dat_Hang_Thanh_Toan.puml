@startuml AD05_Dat_Hang_Thanh_Toan

skinparam backgroundColor #F9F0FF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ActivityBorderColor #6A1B9A
skinparam ActivityBackgroundColor #E1BEE7
skinparam ActivityDiamondBackgroundColor #FFF9C4
skinparam ActivityDiamondBorderColor #F9A825
skinparam ActivityStartColor #6A1B9A
skinparam ActivityEndColor #1B5E20
skinparam ArrowColor #6A1B9A
skinparam NoteBackgroundColor #FFF9C4
skinparam NoteBorderColor #F9A825

title
    <b><size:16>AD-05: Dat Hang & Thanh Toan</size></b>
    <size:11>He Thong Ban Linh Kien Xe May</size>
    <size:10>Trang: ThanhToan.aspx | API: DatHangApi.ashx | Bang: DonHang, ChiTietDonHang</size>
end title

|#F9F0FF| User (Trinh Duyet) |
|#E3F2FD| DatHangApi.ashx |
|#E8F5E9| Database (SQL Server) |

|User (Trinh Duyet)|
start
:Mo ThanhToan.aspx;

|DatHangApi.ashx|
if (Session["User"] ton tai?) then (Khong)
  #FFB3B3 :Redirect -> Dang_nhap.aspx;
  stop
else (Co)
endif

|Database (SQL Server)|
:SELECT ChiTietGioHang + LinhKien\nFROM GioHang JOIN ChiTietGioHang\nJOIN LinhKien WHERE MaNguoiDung=@id;

|DatHangApi.ashx|
if (Gio hang co san pham?) then (Khong)
  #FFB3B3 :Tra ve loi:\n"Gio hang trong!\nVui long chon san pham.";
  |User (Trinh Duyet)|
  :Hien thi thong bao loi;
  stop
else (Co)
endif

|User (Trinh Duyet)|
:Hien thi danh sach SP trong gio\n+ Tong tien tam tinh;
:Nhap Ho Ten nguoi nhan;
:Nhap So Dien Thoai giao hang;
:Nhap Dia Chi giao hang;
if (Chon Phuong Thuc\nThanh Toan?) then (COD)
  note right
    COD: Thanh toan
    khi nhan hang
  end note
else (Chuyen Khoan)
  :Hien thi ma QR Code\nthanh toan;
  note right
    File: qr-code.jpg
    Chuyen khoan truoc
    khi giao hang
  end note
endif
:Nhan nut "Xac Nhan Dat Hang";
:Gui POST: {ten, sdt, diaChi, ptThanhToan};

|DatHangApi.ashx|
:Nhan request;
:Tinh TongTien =\nSUM(SoLuong x GiaBan);

|Database (SQL Server)|
:UPDATE NguoiDung\nSET HoTen=@ten, SoDienThoai=@sdt,\n    DiaChi=@dia\nWHERE MaNguoiDung=@id;
note right
  Luu thong tin giao hang
  vao ho so nguoi dung
end note

:INSERT INTO DonHang\n(MaNguoiDung, NgayDat, TongTien,\n TenNguoiNhan, SdtNhanHang,\n DiaChiGiaoHang, PhuongThucTT,\n TrangThaiTT, TrangThaiDon)\nVALUES (@...,\n  'Chua thanh toan',\n  'Cho xac nhan');

:Lay MaDonHang moi INSERT;

:INSERT INTO ChiTietDonHang\n(MaDonHang, MaLinhKien,\n SoLuong, DonGia)\n-- Sao chep tu ChiTietGioHang;

:DELETE FROM ChiTietGioHang\nWHERE MaGioHang = @magh;
note right
  Xoa sach gio hang
  sau khi dat hang thanh cong
end note

|DatHangApi.ashx|
:Tra ve:\n{ success: true,\n  maDonHang: @maDH };

|User (Trinh Duyet)|
#D5E8D4 :Hien thi:\n"Dat hang thanh cong!\nMa don hang: #@maDH";
:Redirect -> DonHang.aspx;
stop

@enduml
